---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../assets/app.css";

const { pageTitle } = Astro.props;
---

<html lang="en" data-theme="abyss">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DevGeo | Blog"
      href={new URL("rss.xml", Astro.site)}
    />
    <title>{pageTitle + " - gcgbarbosa.com"}</title>
  </head>

  <body class="bg-base-100 text-base-content flex min-h-svh flex-col">
    <!-- <div -->
    <!--   class="mx-auto  max-w-svw items-center justify-between p-2 md:max-w-6xl" -->
    <!-- > -->
    <div
      class="mx-auto flex h-full min-h-svh w-full flex-col gap-2 p-2 md:max-w-6xl"
    >
      <header class="rounded-md border p-2">
        <Header />
      </header>
      <main class="flex-1 rounded-md border p-4">
        <slot />
      </main>
      <footer
        class="flex flex-col items-center justify-center rounded-md border p-2"
      >
        <Footer />
      </footer>
    </div>
    <!-- </div> -->
  </body>
</html>
