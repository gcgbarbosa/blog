---
const pathname = Astro.url.pathname;

const isBlog =
  pathname.startsWith("/blog") ||
  pathname.startsWith("/posts") ||
  pathname.startsWith("/tags");
const isHome = pathname === "/";
---

<div class="flex gap-2">
  <a
    href="/"
    class:list={[
      "px-4 py-2 text-black hover:bg-amber-100 active:bg-blue-300",
      { "bg-white font-bold": isHome, "bg-blue-300": !isHome },
    ]}
  >
    Home
  </a>
  <a
    href="/blog"
    class:list={[
      "px-4 py-2 text-black hover:bg-amber-100 active:bg-blue-300",
      {
        "bg-white font-bold": isBlog,
        "bg-blue-300": !isBlog,
      },
    ]}
  >
    Blog
  </a>
</div>
