---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-row flex-wrap gap-x-1 gap-y-2">
  {
    tags.map((tag) => (
      <a
        class="badge badge-dash badge-secondary hover:border-accent hover:text-accent active:border-primary active:text-primary"
        href={`/tags/${tag}`}
      >
        #{tag}
      </a>
    ))
  }
</div>
