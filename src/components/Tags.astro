---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-row flex-wrap gap-x-1 gap-y-2">
  {
    tags.map((tag) => (
      <div class="badge badge-dash badge-secondary">
        <a class="link link-hover link-secondary" href={`/tags/${tag}`}>
          #{tag}
        </a>
      </div>
    ))
  }
</div>
